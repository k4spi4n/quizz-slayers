{
  "manifest_version": 3,
  "name": "EDUX Slayers Extension",
  "version": "2.5.0",
  "description": "Tự động hóa giải Slide bài giảng, Bài tập & Theo dõi điểm số trên EDUX",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://edux.cmcu.edu.vn/*",
    "*://*.cmcu.edu.vn/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "EDUX Slayers Control"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://edux.cmcu.edu.vn/*",
        "*://*.cmcu.edu.vn/*"
      ],
      "js": ["content/injected.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://edux.cmcu.edu.vn/*",
        "*://*.cmcu.edu.vn/*",
        "<all_urls>"
      ],
      "js": [
        "content/dom-utils.js",
        "content/answer-parser.js",
        "content/exam-dom.js",
        "content/exam-prompt.js",
        "content/exam-solver.js",
        "content/slide-solver.js",
        "content/score-tracker.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/injected.js"],
      "matches": ["*://edux.cmcu.edu.vn/*", "*://*.cmcu.edu.vn/*"]
    }
  ]
}
